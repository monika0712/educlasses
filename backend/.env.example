# MongoDB connection string (use MongoDB Atlas for a free cloud database)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/educlasses

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Port the server runs on (Render sets this automatically, safe to leave)
PORT=5000

# Comma separated list of frontend origins allowed to call this API
# e.g. your Netlify URL: https://educlasses.netlify.app
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Admin account details - used ONLY by `npm run seed:admin` to create/update
# the one admin account in the database. Change the password after seeding
# if you like; it is not read at login time.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@educlasses.com
ADMIN_PASSWORD=change_this_admin_password
